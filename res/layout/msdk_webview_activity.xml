<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical" android:id="@id/playout" android:background="@color/black" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:id="@id/titlebar" android:background="@color/titlebar" android:layout_width="match_parent" android:layout_height="@dimen/titlebar_height" android:layout_alignParentTop="true">
        <ImageButton android:id="@id/openByBrowser" android:background="@drawable/msdk_webview_sel_btn_bg" android:paddingLeft="@dimen/btn_margin_half" android:paddingRight="@dimen/btn_margin_half" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginLeft="@dimen/btn_margin_half" android:src="@drawable/msdk_webview_btn_qqbrowser" android:layout_alignParentLeft="true" />
        <TextView android:textSize="@dimen/titlebar_text_size" android:textColor="@color/titlebar_text" android:gravity="center" android:id="@id/webTitle" android:layout_width="@dimen/titlebar_text_width" android:layout_height="match_parent" android:singleLine="true" android:layout_centerHorizontal="true" />
        <ImageButton android:id="@id/more" android:background="@drawable/msdk_webview_sel_btn_bg" android:paddingLeft="@dimen/btn_margin_half" android:paddingRight="@dimen/btn_margin_half" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginRight="@dimen/btn_margin_half" android:src="@drawable/msdk_webview_btn_more" android:layout_alignParentRight="true" />
    </RelativeLayout>
    <FrameLayout android:id="@id/webview_framelayout" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@id/toolbar" android:layout_below="@id/titlebar">
        <com.tencent.smtt.sdk.WebView android:layout_gravity="left|top" android:id="@id/webview" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>
    <LinearLayout android:id="@id/toolbar" android:background="@color/toolbar_visible" android:layout_width="match_parent" android:layout_height="@dimen/titlebar_height" android:layout_alignParentBottom="true">
        <LinearLayout android:gravity="center" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1.0">
            <ImageButton android:id="@id/back" android:background="@drawable/msdk_webview_sel_btn_bg" android:paddingLeft="@dimen/btn_margin" android:paddingRight="@dimen/btn_margin" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/msdk_webview_btn_left" />
            <ImageButton android:id="@id/backUnclickable" android:background="@drawable/msdk_webview_sel_btn_bg" android:paddingLeft="@dimen/btn_margin" android:paddingRight="@dimen/btn_margin" android:clickable="false" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/msdk_webview_btn_left_disabled" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1.0">
            <ImageButton android:id="@id/forward" android:background="@drawable/msdk_webview_sel_btn_bg" android:paddingLeft="@dimen/btn_margin" android:paddingRight="@dimen/btn_margin" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/msdk_webview_btn_right" />
            <ImageButton android:id="@id/forwardUnclickable" android:background="@drawable/msdk_webview_sel_btn_bg" android:paddingLeft="@dimen/btn_margin" android:paddingRight="@dimen/btn_margin" android:clickable="false" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/msdk_webview_btn_right_disabled" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1.0">
            <ImageButton android:id="@id/stop" android:background="@drawable/msdk_webview_sel_btn_bg" android:paddingLeft="@dimen/btn_margin" android:paddingRight="@dimen/btn_margin" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/msdk_webview_btn_stop" />
            <ImageButton android:id="@id/refresh" android:background="@drawable/msdk_webview_sel_btn_bg" android:paddingLeft="@dimen/btn_margin" android:paddingRight="@dimen/btn_margin" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/msdk_webview_btn_refresh" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:id="@id/land_layout_more" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1.0">
            <ImageButton android:id="@id/landMore" android:background="@drawable/msdk_webview_sel_btn_bg" android:paddingLeft="@dimen/btn_margin" android:paddingRight="@dimen/btn_margin" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/msdk_webview_btn_more" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1.0">
            <ImageButton android:id="@id/return_app" android:background="@drawable/msdk_webview_sel_btn_bg" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginLeft="@dimen/btn_margin" android:layout_marginRight="@dimen/btn_margin" android:src="@drawable/msdk_webview_btn_close" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
