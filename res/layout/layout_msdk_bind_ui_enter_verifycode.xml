        <LinearLayout android:orientation="horizontal" android:id="@id/msdk_bind_not_get_code" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/msdk_bind_space_positive_35" android:layout_below="@id/msdk_bind_verify_code_layout">
