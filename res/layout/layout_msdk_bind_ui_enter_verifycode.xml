        <com.tencent.gcloud.msdk.api.login.ui.MSDKVerifyCodeView android:id="@id/msdk_bind_verify_code_layout" android:layout_width="@dimen/msdk_bind_edittext_with" android:layout_height="wrap_content" android:layout_marginTop="@dimen/msdk_bind_space_positive_5" android:layout_below="@id/msdk_bind_enter_verifycode_title" />
