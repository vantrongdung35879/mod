        <TextView android:textSize="@dimen/tme_danmu_size_select" android:textColor="@color/tme_setting_txt_gray_color" android:gravity="center" android:layout_gravity="center" android:id="@id/txt_middle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tme_font_middle" />
        <TextView android:textSize="@dimen/tme_danmu_size_select" android:textColor="@color/tme_setting_txt_gray_color" android:gravity="center" android:layout_gravity="right" android:id="@id/txt_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tme_font_big" />
    </FrameLayout>
</LinearLayout>
