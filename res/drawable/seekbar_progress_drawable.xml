<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5.0dp" />
            <gradient android:startColor="#bec0bf" android:endColor="#bec0bf" android:angle="270.0" android:centerY="0.75" android:centerColor="#bec0bf" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="5.0dp" />
                <solid android:color="#6da854" />
            </shape>
        </clip>
    </item>
</layer-list>
